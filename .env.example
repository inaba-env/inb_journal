NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# サーバー専用。NEXT_PUBLIC_ を付けないこと
SUPABASE_SECRET_KEY=sb_secret_...

# 本人として扱うメールアドレス
OWNER_EMAIL=a.inaba@env-value.co.jp
# ログインなしで閲覧できる IP（カンマ区切り。IPv4 は CIDR も可）
ALLOWED_IPS=203.0.113.10,198.51.100.0/24

# /github が GitHub の GraphQL API を読むトークン（fine-grained PAT。サーバー専用。NEXT_PUBLIC_ を付けないこと）
# 権限は Issues・Pull requests・Metadata の Read だけ。Resource owner ごとに作る
# Resource owner が e-value-inc
GITHUB_TOKEN_ORG=github_pat_...
# Resource owner が inaba-env
GITHUB_TOKEN_USER=github_pat_...
